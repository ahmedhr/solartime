<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solar Time Debug"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/dateTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Date: 2023-01-01"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/locationTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location: Lat: 0.00, Lon: 82.50"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/northButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="North"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/southButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="South"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/eastButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="East"
                android:layout_margin="4dp" />

            <Button
                android:id="@+id/westButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="West"
                android:layout_margin="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/currentTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Time: 12:00:00"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/simpleSolarTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simple Solar Time: 12:00:00"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/accurateSolarTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Accurate Solar Time: 00:00:00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/highPrecisionSolarTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="High Precision Solar Time: 00:00:00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/ultraPrecisionSolarTimeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ultra Precision Solar Time: 00:00:00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/differenceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Difference: 0.00 minutes (0.00 seconds)"
            android:textSize="16sp" />
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:id="@+id/sunriseTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sunrise: --:--"
                android:textSize="16sp" />
                
            <TextView
                android:id="@+id/sunsetTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sunset: --:--"
                android:textSize="16sp" />
        </LinearLayout>
        
        <Button
            android:id="@+id/showDetailsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Show Advanced Details"
            android:layout_marginBottom="16dp" />
            
        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advanced Solar Details"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />
                
            <TextView
                android:id="@+id/dayLengthTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Day Length: --h --m"
                android:layout_marginBottom="4dp" />
                
            <TextView
                android:id="@+id/solarNoonTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Solar Noon: --:--"
                android:layout_marginBottom="4dp" />
                
            <TextView
                android:id="@+id/eotValueTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EoT Value: -- minutes"
                android:layout_marginBottom="4dp" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Astronomical Formulas Used:"
                android:textStyle="italic"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Advanced EoT: 229.18 * (0.000075 + 0.001868*cos(γ) - 0.032077*sin(γ) - 0.014615*cos(2γ) - 0.040849*sin(2γ))"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Solar Declination: 23.45° * sin(0.9863° * (day-81))"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />
                
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Sunrise/Sunset: cos(h₀) = (cos(90.833°) - sin(φ)sin(δ)) / (cos(φ)cos(δ))"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/componentsTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:text="Calculation Components:\n- Component 1\n- Component 2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Explanation:"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simple Solar Time: Uses only longitude to calculate solar time.\n\nAccurate Solar Time: Includes the Equation of Time adjustment, which accounts for Earth's elliptical orbit and axial tilt, as well as corrections for time zone, DST, and atmospheric refraction."
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView> 